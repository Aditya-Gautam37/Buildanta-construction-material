  approvedBy                    User?  @relation("PlanningCoefficientApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedById                  String?
  publishedBy                    User?  @relation("PlanningCoefficientPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@unique([code, version])
  @@index([materialKey, status])
  @@index([regionalProfileId, status])
  @@index([stageId, status])
}

// ==========================================
// 7B. CART & DIRECT PURCHASE
// ==========================================

model Cart {
  id                       String     @id @default(cuid())
  customerId               String?
  customer                 User?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestToken               String?    @unique
  status                   CartStatus @default(ACTIVE)
  currency                 String     @default("INR")
  conversionIdempotencyKey String?
  convertedAt              DateTime?
  lastActivityAt           DateTime   @default(now())
  items                    CartItem[]
  quotation                Quotation?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([customerId, status])
  @@index([guestToken])
  @@index([status, lastActivityAt])
}

model CartItem {
  id                String         @id @default(cuid())
  cartId            String
  cart              Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPriceSnapshot Decimal?       @db.Decimal(12, 2)
  addedAt           DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ==========================================
// 8. COMMERCIAL REQUEST WORKFLOWS
// ==========================================

model QuoteRequest {
  id              String             @id @default(cuid())
  reference       String             @unique
  name            String
  email           String
  phone           String
  company         String
  requirement     String             @db.Text
  quantity        Int
  deliveryPincode String
  requiredBy      String?
  projectType     String?
  notes           String?            @db.Text
  status          QuoteRequestStatus @default(NEW)
  quotation       Quotation?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Quotation {
  id                    String                   @id @default(cuid())
  reference             String                   @unique
  sourceQuoteRequestId  String?                  @unique
  sourceQuoteRequest    QuoteRequest?            @relation(fields: [sourceQuoteRequestId], references: [id], onDelete: SetNull)
  sourceCartId          String?                  @unique
  sourceCart            Cart?                    @relation(fields: [sourceCartId], references: [id], onDelete: SetNull)
  customerUserId        String?
  customerName          String
  customerEmail         String
  customerPhone         String
  company               String?
  deliveryPincode       String
  requiredBy            DateTime?
  projectType           String?
  customerNotes         String?                  @db.Text
  internalNotes         String?                  @db.Text
  status                QuotationStatus          @default(DRAFT)
  currentRevisionNumber Int                      @default(0)
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  expiresAt             DateTime?
  createdById           String?
  createdBy             User?                    @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items                 QuotationItem[]
  revisions             QuotationRevision[]
  history               QuotationStatusHistory[]
  approvals             QuotationApproval[]
  salesOrder            SalesOrder?
  materialEstimate      MaterialEstimate?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
  @@index([deliveryPincode, status])
  @@index([createdById, createdAt])
}

model QuotationItem {
  id              String                  @id @default(cuid())
  quotationId     String
  quotation       Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description     String
  quantity        Decimal                 @db.Decimal(14, 3)
  unitCode        String
  customerNotes   String?                 @db.Text
  sortOrder       Int                     @default(0)
  revisionItems   QuotationRevisionItem[]
  salesOrderItems SalesOrderItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([quotationId, sortOrder])
  @@index([productId])
  @@index([variantId])
}

model QuotationRevision {
  id            String                  @id @default(cuid())
  quotationId   String
  quotation     Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  number        Int
  validUntil    DateTime
  subtotal      Decimal                 @db.Decimal(14, 2)
  gstTotal      Decimal                 @db.Decimal(14, 2)
  freightTotal  Decimal                 @db.Decimal(14, 2)
  discountTotal Decimal                 @db.Decimal(14, 2)
  marginTotal   Decimal?                @db.Decimal(14, 2)
  grandTotal    Decimal                 @db.Decimal(14, 2)
  customerNotes String?                 @db.Text
  internalNotes String?                 @db.Text
  createdById   String?
  createdBy     User?                   @relation("QuotationRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  sentAt        DateTime?
  items         QuotationRevisionItem[]
  approvals     QuotationApproval[]
  salesOrders   SalesOrder[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([quotationId, number])
  @@index([validUntil])
  @@index([createdById, createdAt])
}

model QuotationRevisionItem {
  id                   String              @id @default(cuid())
  revisionId           String
  revision             QuotationRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  quotationItemId      String
  quotationItem        QuotationItem       @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)
  variantId            String?
  variant              ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  fulfilmentLocationId String?
  fulfilmentLocation   FulfilmentLocation? @relation(fields: [fulfilmentLocationId], references: [id], onDelete: SetNull)
  supplierProductId    String?
  supplierProduct      SupplierProduct?    @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  dealerProductId      String?
  dealerProduct        DealerProduct?      @relation(fields: [dealerProductId], references: [id], onDelete: SetNull)
  description          String
  quantity             Decimal             @db.Decimal(14, 3)
  unitCode             String
  unitPrice            Decimal             @db.Decimal(14, 2)
  gstPercent           Decimal             @db.Decimal(5, 2)
  discountAmount       Decimal             @db.Decimal(14, 2)
  lineSubtotal         Decimal             @db.Decimal(14, 2)
  gstAmount            Decimal             @db.Decimal(14, 2)
  lineTotal            Decimal             @db.Decimal(14, 2)
  estimatedLeadDays    Int?
  isAlternative        Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([revisionId, quotationItemId])
  @@index([variantId])
  @@index([fulfilmentLocationId])
  @@index([supplierProductId])
  @@index([dealerProductId])
}

model QuotationStatusHistory {
  id          String           @id @default(cuid())
  quotationId String
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  fromStatus  QuotationStatus?
  toStatus    QuotationStatus
  reason      String?
  actorId     String?
  actor       User?            @relation("QuotationStatusActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([quotationId, createdAt])
  @@index([actorId, createdAt])
}

model QuotationApproval {
  id            String                  @id @default(cuid())
  quotationId   String
  quotation     Quotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  revisionId    String
  revision      QuotationRevision       @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  status        QuotationApprovalStatus @default(PENDING)
  reason        String?
  requestedById String?
  requestedBy   User?                   @relation("QuotationApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?                   @relation("QuotationApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([quotationId, status])
  @@index([revisionId, status])
}

model SalesOrder {
  id                 String             @id @default(cuid())
  reference          String             @unique
  quotationId        String             @unique
  quotation          Quotation          @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  revisionId         String
  revision           QuotationRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  status             SalesOrderStatus   @default(CONFIRMED)
  paymentTerms       String?
  paymentStatus      PaymentStatus      @default(PENDING)
  customerName       String
  customerEmail      String
  customerPhone      String
  deliveryPincode    String
  subtotal           Decimal            @db.Decimal(14, 2)
  gstTotal           Decimal            @db.Decimal(14, 2)
  freightTotal       Decimal            @db.Decimal(14, 2)
  discountTotal      Decimal            @db.Decimal(14, 2)
  grandTotal         Decimal            @db.Decimal(14, 2)
  reservedUntil      DateTime?
  createdById        String?
  createdBy          User?              @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledById      String?
  cancelledBy        User?              @relation("SalesOrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt        DateTime?
  cancellationReason String?
  items              SalesOrderItem[]
  pickingLists       PickingList[]
  deliverySchedules  DeliverySchedule[]
  dispatches         Dispatch[]
  returnRequests     ReturnRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail, createdAt])
  @@index([reservedUntil, status])
}

model SalesOrderItem {
  id                   String                @id @default(cuid())
  salesOrderId         String
  salesOrder           SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  quotationItemId      String
  quotationItem        QuotationItem         @relation(fields: [quotationItemId], references: [id], onDelete: Restrict)
  variantId            String
  variant              ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation    @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  description          String
  quantity             Int
  unitCode             String
  unitPrice            Decimal               @db.Decimal(14, 2)
  gstPercent           Decimal               @db.Decimal(5, 2)
  discountAmount       Decimal               @db.Decimal(14, 2)
  lineSubtotal         Decimal               @db.Decimal(14, 2)
  gstAmount            Decimal               @db.Decimal(14, 2)
  lineTotal            Decimal               @db.Decimal(14, 2)
  reservation          InventoryReservation?
  pickingItems         PickingListItem[]
  dispatchItems        DispatchItem[]
  returnItems          ReturnItem[]
  replacementItems     ReplacementItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([salesOrderId, quotationItemId])
  @@index([variantId])
  @@index([fulfilmentLocationId])
}

// ==========================================
// 8. PURCHASING, DELIVERY & RETURNS
// ==========================================

model PurchaseRequisition {
  id             String                    @id @default(cuid())
  reference      String                    @unique
  status         PurchaseRequisitionStatus @default(DRAFT)
  requiredBy     DateTime?
  reason         String                    @db.Text
  internalNotes  String?                   @db.Text
  createdById    String?
  submittedAt    DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decisionReason String?
  items          PurchaseRequisitionItem[]
  rfqs           SupplierRFQ[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([requiredBy, status])
}

model PurchaseRequisitionItem {
  id                    String              @id @default(cuid())
  purchaseRequisitionId String
  purchaseRequisition   PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  variantId             String
  variant               ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  targetLocationId      String
  targetLocation        FulfilmentLocation  @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  quantity              Int
  unitCode              String
  notes                 String?
  rfqItems              SupplierRFQItem[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([purchaseRequisitionId])
  @@index([variantId, targetLocationId])
}

model SupplierRFQ {
  id                    String                @id @default(cuid())
  reference             String                @unique
  purchaseRequisitionId String?
  purchaseRequisition   PurchaseRequisition?  @relation(fields: [purchaseRequisitionId], references: [id], onDelete: SetNull)
  status                SupplierRFQStatus     @default(DRAFT)
  responseDueAt         DateTime?
  sentAt                DateTime?
  closedAt              DateTime?
  notes                 String?               @db.Text
  createdById           String?
  items                 SupplierRFQItem[]
  responses             SupplierRFQResponse[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([purchaseRequisitionId])
}

model SupplierRFQItem {
  id                        String                    @id @default(cuid())
  supplierRfqId             String
  supplierRfq               SupplierRFQ               @relation(fields: [supplierRfqId], references: [id], onDelete: Cascade)
  purchaseRequisitionItemId String?
  purchaseRequisitionItem   PurchaseRequisitionItem?  @relation(fields: [purchaseRequisitionItemId], references: [id], onDelete: SetNull)
  variantId                 String
  variant                   ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)
  targetLocationId          String
  targetLocation            FulfilmentLocation        @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  quantity                  Int
  unitCode                  String
  responseItems             SupplierRFQResponseItem[]
  createdAt                 DateTime                  @default(now())

  @@index([supplierRfqId])
  @@index([variantId, targetLocationId])
}

model SupplierRFQResponse {
  id             String                    @id @default(cuid())
  reference      String                    @unique
  supplierRfqId  String
  supplierRfq    SupplierRFQ               @relation(fields: [supplierRfqId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status         SupplierResponseStatus    @default(SUBMITTED)
  validUntil     DateTime
  freightTotal   Decimal                   @default(0) @db.Decimal(14, 2)
  notes          String?                   @db.Text
  items          SupplierRFQResponseItem[]
  purchaseOrders PurchaseOrder[]
  submittedAt    DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([supplierRfqId, supplierId])
  @@index([status, validUntil])
}

model SupplierRFQResponseItem {
  id                String              @id @default(cuid())
  responseId        String
  response          SupplierRFQResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  supplierRfqItemId String
  supplierRfqItem   SupplierRFQItem     @relation(fields: [supplierRfqItemId], references: [id], onDelete: Cascade)
  offeredQuantity   Int
  unitCost          Decimal             @db.Decimal(14, 2)
  gstPercent        Decimal             @default(0) @db.Decimal(5, 2)
  leadTimeDays      Int
  createdAt         DateTime            @default(now())

  @@unique([responseId, supplierRfqItemId])
}

model PurchaseOrder {
  id                 String                         @id @default(cuid())
  reference          String                         @unique
  supplierId         String
  supplier           Supplier                       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierResponseId String?
  supplierResponse   SupplierRFQResponse?           @relation(fields: [supplierResponseId], references: [id], onDelete: SetNull)
  status             PurchaseOrderStatus            @default(DRAFT)
  expectedAt         DateTime?
  subtotal           Decimal                        @db.Decimal(14, 2)
  gstTotal           Decimal                        @db.Decimal(14, 2)
  freightTotal       Decimal                        @default(0) @db.Decimal(14, 2)
  grandTotal         Decimal                        @db.Decimal(14, 2)
  paymentTerms       String?
  internalNotes      String?                        @db.Text
  createdById        String?
  approvedById       String?
  approvedAt         DateTime?
  sentAt             DateTime?
  items              PurchaseOrderItem[]
  approvalHistory    PurchaseOrderApprovalHistory[]
  goodsReceipts      GoodsReceipt[]
  supplierReturns    SupplierReturn[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([status, createdAt])
  @@index([supplierId, status])
}

model PurchaseOrderItem {
  id                  String               @id @default(cuid())
  purchaseOrderId     String
  purchaseOrder       PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId           String
  variant             ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  targetLocationId    String
  targetLocation      FulfilmentLocation   @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  orderedQuantity     Int
  receivedQuantity    Int                  @default(0)
  unitCode            String
  unitCost            Decimal              @db.Decimal(14, 2)
  gstPercent          Decimal              @default(0) @db.Decimal(5, 2)
  lineTotal           Decimal              @db.Decimal(14, 2)
  goodsReceiptItems   GoodsReceiptItem[]
  supplierReturnItems SupplierReturnItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([purchaseOrderId])
  @@index([variantId, targetLocationId])
}

model PurchaseOrderApprovalHistory {
  id              String                   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder            @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  decision        PurchaseApprovalDecision
  reason          String?
  actorId         String?
  createdAt       DateTime                 @default(now())

  @@index([purchaseOrderId, createdAt])
}

model GoodsReceipt {
  id                   String             @id @default(cuid())
  reference            String             @unique
  purchaseOrderId      String
  purchaseOrder        PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  status               GoodsReceiptStatus @default(DRAFT)
  supplierDocument     String?
  receivedAt           DateTime
  postedAt             DateTime?
  postedById           String?
  qualityNotes         String?            @db.Text
  items                GoodsReceiptItem[]
  supplierReturns      SupplierReturn[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([purchaseOrderId, status])
  @@index([fulfilmentLocationId, receivedAt])
}

model GoodsReceiptItem {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variantId           String
  variant             ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receivedQuantity    Int
  acceptedQuantity    Int
  rejectedQuantity    Int               @default(0)
  damagedQuantity     Int               @default(0)
  shortageQuantity    Int               @default(0)
  excessQuantity      Int               @default(0)
  batchNumber         String?
  lotNumber           String?
  manufacturedAt      DateTime?
  expiresAt           DateTime?
  inspectionNotes     String?
  createdAt           DateTime          @default(now())

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([variantId, batchNumber])
}

model SupplierReturn {
  id                   String               @id @default(cuid())
  reference            String               @unique
  supplierId           String
  supplier             Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId      String?
  purchaseOrder        PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId       String?
  goodsReceipt         GoodsReceipt?        @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation   @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  status               SupplierReturnStatus @default(DRAFT)
  reason               String               @db.Text
  approvedById         String?
  dispatchedAt         DateTime?
  items                SupplierReturnItem[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([supplierId])
}

model SupplierReturnItem {
  id                  String             @id @default(cuid())
  supplierReturnId    String
  supplierReturn      SupplierReturn     @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  variantId           String
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity            Int
  fromDamaged         Boolean            @default(false)
  createdAt           DateTime           @default(now())

  @@index([supplierReturnId])
}

model PickingList {
  id                   String             @id @default(cuid())
  reference            String             @unique
  salesOrderId         String
  salesOrder           SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  status               PickingListStatus  @default(DRAFT)
  assignedToId         String?
  pickedAt             DateTime?
  items                PickingListItem[]
  dispatches           Dispatch[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([salesOrderId, status])
  @@index([fulfilmentLocationId, status])
}

model PickingListItem {
  id                String         @id @default(cuid())
  pickingListId     String
  pickingList       PickingList    @relation(fields: [pickingListId], references: [id], onDelete: Cascade)
  salesOrderItemId  String
  salesOrderItem    SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  requestedQuantity Int
  pickedQuantity    Int            @default(0)
  createdAt         DateTime       @default(now())

  @@unique([pickingListId, salesOrderItemId])
}

model DeliverySchedule {
  id              String                 @id @default(cuid())
  reference       String                 @unique
  salesOrderId    String
  salesOrder      SalesOrder             @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  carrierId       String?
  carrier         Carrier?               @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  scheduledFor    DateTime
  status          DeliveryScheduleStatus @default(PLANNED)
  deliveryAddress String                 @db.Text
  contactName     String
  contactPhone    String
  notes           String?
  dispatches      Dispatch[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([salesOrderId, scheduledFor])
  @@index([status, scheduledFor])
}

model Dispatch {
  id                 String                  @id @default(cuid())
  reference          String                  @unique
  salesOrderId       String
  salesOrder         SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  pickingListId      String?
  pickingList        PickingList?            @relation(fields: [pickingListId], references: [id], onDelete: SetNull)
  deliveryScheduleId String?
  deliverySchedule   DeliverySchedule?       @relation(fields: [deliveryScheduleId], references: [id], onDelete: SetNull)
  carrierId          String?
  carrier            Carrier?                @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  status             DispatchStatus          @default(DRAFT)
  vehicleNumber      String?
  trackingReference  String?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  createdById        String?
  items              DispatchItem[]
  challan            DeliveryChallan?
  history            DeliveryStatusHistory[]
  proofOfDelivery    ProofOfDelivery?
  returnRequests     ReturnRequest[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([salesOrderId, status])
  @@index([status, createdAt])
}

model DispatchItem {
  id                   String               @id @default(cuid())
  dispatchId           String
  dispatch             Dispatch             @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrderItemId     String
  salesOrderItem       SalesOrderItem       @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  reservationId        String
  reservation          InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation   @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  quantity             Int
  createdAt            DateTime             @default(now())

  @@unique([dispatchId, salesOrderItemId])
  @@index([salesOrderItemId])
  @@index([reservationId])
}

model DeliveryChallan {
  id          String   @id @default(cuid())
  number      String   @unique
  dispatchId  String   @unique
  dispatch    Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  documentUrl String?
  notes       String?
  createdAt   DateTime @default(now())
}

model DeliveryStatusHistory {
  id         String          @id @default(cuid())
  dispatchId String
  dispatch   Dispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fromStatus DispatchStatus?
  toStatus   DispatchStatus
  notes      String?
  actorId    String?
  createdAt  DateTime        @default(now())

  @@index([dispatchId, createdAt])
}

model ProofOfDelivery {
  id           String   @id @default(cuid())
  dispatchId   String   @unique
  dispatch     Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  receivedBy   String
  receivedAt   DateTime
  photoUrl     String?
  signatureUrl String?
  notes        String?
  recordedById String?
  createdAt    DateTime @default(now())
}

model ReturnRequest {
  id            String              @id @default(cuid())
  reference     String              @unique
  salesOrderId  String
  salesOrder    SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchId    String?
  dispatch      Dispatch?           @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  status        ReturnRequestStatus @default(REQUESTED)
  reason        String              @db.Text
  customerNotes String?             @db.Text
  internalNotes String?             @db.Text
  requestedAt   DateTime            @default(now())
  approvedAt    DateTime?
  receivedAt    DateTime?
  inspectedAt   DateTime?
  resolvedAt    DateTime?
  actorId       String?
  items         ReturnItem[]
  replacement   Replacement?
  creditNote    CreditNote?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([salesOrderId])
}

model ReturnItem {
  id                   String             @id @default(cuid())
  returnRequestId      String
  returnRequest        ReturnRequest      @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  salesOrderItemId     String
  salesOrderItem       SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  variantId            String
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  requestedQuantity    Int
  receivedQuantity     Int                @default(0)
  inspection           ReturnInspection?
  replacementItems     ReplacementItem[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([returnRequestId, salesOrderItemId])
  @@index([variantId, fulfilmentLocationId])
}

model ReturnInspection {
  id               String                   @id @default(cuid())
  returnItemId     String                   @unique
  returnItem       ReturnItem               @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  decision         ReturnInspectionDecision
  restockQuantity  Int                      @default(0)
  damagedQuantity  Int                      @default(0)
  rejectedQuantity Int                      @default(0)
  notes            String?
  inspectedById    String?
  inspectedAt      DateTime                 @default(now())
}

model Replacement {
  id              String            @id @default(cuid())
  reference       String            @unique
  returnRequestId String            @unique
  returnRequest   ReturnRequest     @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  status          ReplacementStatus @default(APPROVED)
  notes           String?
  items           ReplacementItem[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, createdAt])
}

model ReplacementItem {
  id                   String             @id @default(cuid())
  replacementId        String
  replacement          Replacement        @relation(fields: [replacementId], references: [id], onDelete: Cascade)
  returnItemId         String
  returnItem           ReturnItem         @relation(fields: [returnItemId], references: [id], onDelete: Restrict)
  salesOrderItemId     String
  salesOrderItem       SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)
  variantId            String
  variant              ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  fulfilmentLocationId String
  fulfilmentLocation   FulfilmentLocation @relation(fields: [fulfilmentLocationId], references: [id], onDelete: Restrict)
  quantity             Int
  createdAt            DateTime           @default(now())

  @@index([replacementId])
}

model CreditNote {
  id              String           @id @default(cuid())
  reference       String           @unique
  returnRequestId String           @unique
  returnRequest   ReturnRequest    @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  status          CreditNoteStatus @default(DRAFT)
  amount          Decimal          @db.Decimal(14, 2)
  reason          String           @db.Text
  issuedAt        DateTime?
  issuedById      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
}

model SupplierSubmission {
  id          String                   @id @default(cuid())
  reference   String                   @unique
  contactName String
  email       String
  phone       String
  company     String
  productName String
  brand       String
  category    String
  unit        String
  price       Decimal                  @db.Decimal(12, 2)
  stock       Int
  description String                   @db.Text
  imageUrl    String
  status      SupplierSubmissionStatus @default(PENDING)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
