{
  "name": "buildanta-inventory-platform",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter inventory-management dev",
    "dev:api": "pnpm --filter nest-api dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:deploy": "pnpm --filter @workspace/db db:deploy",
    "db:seed": "pnpm --filter @workspace/db db:seed",
    "db:seed-calculators": "pnpm --filter @workspace/db db:seed-calculators",
    "db:verify-phase2": "pnpm --filter @workspace/db db:verify-phase2",
    "db:verify-phase3": "pnpm --filter @workspace/db db:verify-phase3",
    "db:migrate-old-catalog": "pnpm --filter @workspace/db db:migrate-old-catalog"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.8",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=20"
  }
}
