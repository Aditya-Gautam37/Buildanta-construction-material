  packages        ContractorPackage[]

  @@index([type, published, sortOrder])
  @@index([published, featured])
}

// A contractor's published rate card: the tiers they advertise, each with a
// per-square-foot rate, what the tier includes and which material brands they
// use. Named freely by the contractor rather than forced into fixed tiers,
// because they market their own package names.
//
// Rates move with the market, so these are edited by staff routinely. Nothing
// here is a quote: the storefront multiplies rate by plot area to show an
// estimate, clearly labelled as one.
// Visibility is a single enum rather than an enum plus a boolean: two sources
// of truth for "is this public" is how draft content leaks.
enum PackageStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

// Contractors quote against different things. Most in Kanpur price per square
// foot of plot area; some price per built-up area, which for a two-storey house
// is roughly double. Storing the basis per package means the customer is never
// guessing which number to type, and no contractor is forced into the other
// convention.
enum PackageRateBasis {
  PLOT_AREA
  BUILT_UP_AREA
}

// A controlled vocabulary so two packages can be compared row by row. Free text
// here would make the comparison table impossible to align.
enum PackageInclusionCategory {
  STRUCTURE
  PLASTER
  ELECTRICAL
  PLUMBING
  FLOORING
  WINDOWS
  DOORS
  KITCHEN
  BATHROOM
  PAINT
  CEILING
  ELEVATION
  WATER_TANK
  RAILING
  OTHER
}

model ContractorPackage {
  id             String           @id @default(cuid())
  professionalId String
  name           String
  slug           String
  // tagline is the short marketing strip a contractor prints on a flyer
  // ("Budget friendly | Value for money"); summary is a sentence explaining
  // the package.
  tagline        String?
  summary        String?          @db.Text
  ratePerSqFt    Decimal          @db.Decimal(12, 2)
  rateBasis      PackageRateBasis @default(PLOT_AREA)
  // The worked example a contractor advertises ("₹11,25,000 for a 900 sq ft
  // plot"). Stored rather than derived so it matches their own printed figure.
  exampleArea    Decimal?         @db.Decimal(12, 2)
  exampleCost    Decimal?         @db.Decimal(14, 2)
  bestFor        String[]
  exclusions     String[]
  terms          String?          @db.Text
  validFrom      DateTime?
  validUntil     DateTime?
  sortOrder      Int              @default(0)
  status         PackageStatus    @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  inclusionItems ContractorPackageInclusion[]
  materials      ContractorPackageMaterial[]

  @@unique([professionalId, name])
  @@unique([professionalId, slug])
  @@index([professionalId, status, sortOrder])
}

model ContractorPackageInclusion {
  id              String                   @id @default(cuid())
  packageId       String
  category        PackageInclusionCategory @default(OTHER)
  label           String
  description     String?
  // Contractors advertise allowances customers compare directly, e.g.
  // "floor tiles up to ₹40 per sq ft".
  allowanceAmount Decimal?                 @db.Decimal(12, 2)
  allowanceUnit   String?
  sortOrder       Int                      @default(0)

  package         ContractorPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
}

model ContractorPackageMaterial {
  id               String            @id @default(cuid())
  packageId        String
  category         String
  specification    String
  // Presented to customers as the contractor's own proposal, never as a
  // Buildanta endorsement.
  preferredBrands  String?
  substitutionNote String?
  sortOrder        Int               @default(0)

  package          ContractorPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
}

