{
  "name": "inventory-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "prebuild": "pnpm --filter @workspace/db db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\"",
    "test:unit": "vitest run",
    "seed:real-catalogue": "tsx --env-file=.env.local scripts/seed-real-catalogue.ts",
    "seed:serviceability": "tsx --env-file=.env.local scripts/seed-serviceability.ts",
    "verify:catalogue": "tsx --env-file=.env.local scripts/verify-catalogue.ts",
    "cleanup:demo": "tsx --env-file=.env.local scripts/clear-demo-data.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@trpc/client": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "@workspace/db": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.577.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
