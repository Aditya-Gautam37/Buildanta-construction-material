# PostgreSQL (server only)
# Vercel/serverless runtime: shared transaction-mode pooler (IPv4).
DATABASE_URL=postgresql://postgres.yodbawxefjwkxlclgcnr:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: shared session-mode pooler (IPv4).
DIRECT_URL=postgresql://postgres.yodbawxefjwkxlclgcnr:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Keep a separate local shadow database for `prisma migrate dev`.
SHADOW_DATABASE_URL=postgresql://buildanta:buildanta@localhost:5433/buildanta_inventory_shadow

# Next.js inventory app
NEXT_PUBLIC_API_URL=http://localhost:5173
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy fallback only:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional comma-separated image hosts when catalog assets live in another project.
NEXT_PUBLIC_ASSET_HOSTS=
INVENTORY_PORT=3002

# NestJS API (server only)
PORT=5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy fallback only:
SUPABASE_ANON_KEY=
# Preferred private backend key. Never expose it through a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3002

# Rate limiting (NestJS API). Requests per minute, per IP, before a 429.
# Checkout has its own tighter limit (5/min) baked into the route directly —
# see cart.controller.ts, not env-configurable for technical reasons documented there.
CART_RATE_LIMIT_PER_MINUTE=120

# Observability (NestJS API). All optional — the app starts and runs
# normally with none of these set; error tracking is simply off.
# DSN from your Sentry project settings. Leave unset to disable Sentry entirely.
SENTRY_DSN=
# Defaults to NODE_ENV if unset.
SENTRY_ENVIRONMENT=production
# Fraction of requests to sample for performance tracing, 0-1. Defaults to 0 (errors only, no tracing).
SENTRY_TRACES_SAMPLE_RATE=0

# Staff provisioning. Public signups not listed here remain CUSTOMER accounts.
ADMIN_EMAIL_ALLOWLIST=admin@example.com
DATA_ENTRY_EMAIL_ALLOWLIST=inventory@example.com

# Durable Supabase Storage buckets. Create these as public buckets with write access
# restricted by RLS, or use the authenticated server upload route included here.
SUPABASE_PRODUCT_IMAGES_BUCKET=ProductPhotos
SUPABASE_BRAND_LOGOS_BUCKET=BrandLogos
SUPABASE_PROFESSIONAL_PHOTOS_BUCKET=ProductPhotos
SUPABASE_HOMEPAGE_IMAGES_BUCKET=ProductPhotos
MAX_UPLOAD_BYTES=5242880
