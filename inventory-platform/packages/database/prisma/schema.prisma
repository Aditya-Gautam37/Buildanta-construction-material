model User {
  id                String   @id // Supabase Auth UUID
  email             String   @unique
  firstName         String?
  lastName          String?
  role              UserRole @default(CUSTOMER)
  customPermissions Json?

  reviews                     Review[]
  stockTransactions           StockTransaction[]
  inventoryLedgerEntries      InventoryLedgerEntry[]
  quotationsCreated           Quotation[]              @relation("QuotationCreatedBy")
  quotationRevisionsCreated   QuotationRevision[]      @relation("QuotationRevisionCreatedBy")
  quotationStatusChanges      QuotationStatusHistory[] @relation("QuotationStatusActor")
  quotationApprovalsRequested QuotationApproval[]      @relation("QuotationApprovalRequestedBy")
  quotationApprovalsDecided   QuotationApproval[]      @relation("QuotationApprovalDecidedBy")
  salesOrdersCreated          SalesOrder[]             @relation("SalesOrderCreatedBy")
  salesOrdersCancelled        SalesOrder[]             @relation("SalesOrderCancelledBy")
  calculatorVersionsCreated   CalculatorVersion[]      @relation("CalculatorVersionCreatedBy")
  calculatorVersionsPublished CalculatorVersion[]      @relation("CalculatorVersionPublishedBy")
  calculatorAuditEvents       CalculatorAuditEvent[]
  roomTemplatesCreated        RoomTemplate[]           @relation("RoomTemplateCreatedBy")
  roomTemplatesPublished      RoomTemplate[]           @relation("RoomTemplatePublishedBy")
  planningCoefficientsCreated  PlanningCoefficient[]    @relation("PlanningCoefficientCreatedBy")
  planningCoefficientsApproved PlanningCoefficient[]    @relation("PlanningCoefficientApprovedBy")
  planningCoefficientsPublished PlanningCoefficient[]   @relation("PlanningCoefficientPublishedBy")
  carts                       Cart[]
  materialKnowledgeVerified   MaterialKnowledge[] @relation("MaterialKnowledgeVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ==========================================
// 2. TAXONOMIES & BRANDS
// ==========================================

model Brand {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  logo        String? // URL to Supabase Storage
  description String? @db.Text
  website     String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?    @db.Text
  imageUrl       String?
  icon           String?
  sortOrder      Int        @default(0)
  featured       Boolean    @default(false)
  published      Boolean    @default(true)
  seoTitle       String?
  seoDescription String?    @db.Text
  parentId       String?
  parent         Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children       Category[] @relation("SubCategories")
  products       Product[]  @relation("CategoryToProduct")
  calculatorMappings CalculatorProductMapping[]
  taxonomyLinks  TaxonomyCategoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, published, sortOrder])
  @@index([published, featured, sortOrder])
}

model Stage {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  imageUrl String?
  parentId String?
  parent   Stage?    @relation("StageHierarchy", fields: [parentId], references: [id])
  children Stage[]   @relation("StageHierarchy")
  products Product[] @relation("ProductToStage")
  planningCoefficients PlanningCoefficient[]
  categoryLinks TaxonomyCategoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  imageUrl String?
  parentId String?
  parent   Room?     @relation("RoomHierarchy", fields: [parentId], references: [id])
  children Room[]    @relation("RoomHierarchy")
  products Product[] @relation("ProductToRoom")
  categoryLinks TaxonomyCategoryLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rooms and stages have no relation to categories, so the storefront cannot
/// answer "what does a living room need" without one. Deriving it from product
/// tags leaves the wizard silently incomplete while the catalogue is thin, so
/// the link is explicit and staff-curated.
///
/// INCLUDE rows carry the mapping and its display order, normally at root
/// category level. EXCLUDE rows hide one subcategory from one owner at any
/// depth, so a room inherits new subcategories automatically but can still drop
/// the few that do not belong.
model TaxonomyCategoryLink {
  id         String            @id @default(cuid())
  ownerType  TaxonomyOwnerType
  roomId     String?
  room       Room?             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  stageId    String?
  stage      Stage?            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mode       TaxonomyLinkMode  @default(INCLUDE)
  sortOrder  Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, categoryId, mode])
  @@unique([stageId, categoryId, mode])
  @@index([ownerType, mode, sortOrder])
  @@index([categoryId])
}

enum TaxonomyOwnerType {
  ROOM
  STAGE
}

enum TaxonomyLinkMode {
  INCLUDE
  EXCLUDE
}

// ==========================================
// 3. THE PRODUCT (Catalog)
// ==========================================

model Product {
  id                String   @id @default(cuid())
  name              String
  description       String?  @db.Text
  keySpecifications String[]

  // Brand Relation
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  // Pricing Strategy
  sellingPrice         Decimal       @db.Decimal(12, 2)
  costPrice            Decimal?      @db.Decimal(12, 2)
  dummyPrice           Decimal?      @db.Decimal(12, 2) // MSRP/Strikethrough
  bulkPrice            Decimal?      @db.Decimal(12, 2)
  gstPercent           Decimal?      @db.Decimal(5, 2)
  unit                 String        @default("unit")
  minimumOrderQuantity Int           @default(1)
  deliveryInfo         String?
  returnEligible       Boolean?
  status               ProductStatus @default(DRAFT)
  publishedAt          DateTime?

  // Relations
  categories Category[] @relation("CategoryToProduct")
  stages     Stage[]    @relation("ProductToStage")
  rooms      Room[]     @relation("ProductToRoom")

  images            ProductImage[]
  reviews           Review[]
  variants          ProductVariant[]
  homepagePlacement HomepageProduct?
  quotationItems    QuotationItem[]
  calculatorMappings CalculatorProductMapping[]
  estimateItems      MaterialEstimateItem[]
  materialKnowledge  MaterialKnowledge?
  relatedAsSupportingMaterial MaterialRelatedProduct[] @relation("RelatedProductLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([status, updatedAt])
}

// ==========================================
// Know Your Material — verified product knowledge
// ==========================================
// One record per Product, not per ProductVariant: the facts that matter here
// (coverage rate, mixing ratio, curing time, surface compatibility, safety)
// are chemistry/formulation properties that don't change between pack sizes
// of the same product. Manufacturer and category are deliberately not
// duplicated here — they're read from Product.brand / Product.categories at
// query time, so this table can't drift out of sync with the catalogue.
enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model MaterialKnowledge {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  status KnowledgeStatus @default(DRAFT)

  summary             String?  @db.Text
  useCases             String[]
  suitableSurfaces     String[]
  unsuitableSurfaces   String[]
  preparationSteps     String[]
  applicationSteps     String[]
  sequenceNote         String?  @db.Text // e.g. "Apply after primer, before topcoat" — position in a typical job, not the steps to use this product itself
  mixingInstructions   String?  @db.Text
  requiredTools        String[]

  coverageValue      Decimal? @db.Decimal(12, 4)
  coverageUnit       String? // e.g. "sqft/L", "sqft/kg" — paired with coverageValue, never assumed
  coverageConditions String?  @db.Text // e.g. "on a smooth, primed surface, single coat"
  numberOfCoats      Int?
  dryingCuringInfo   String?  @db.Text // kept as verified free text rather than split fields: manufacturers phrase this too inconsistently (touch-dry/recoat/full-cure, temperature-dependent) to force into rigid columns without losing meaning

  safetyPrecautions String[]
  commonMistakes    String[]
  professionalTips  String[]

  technicalDataSheetUrl String?
  sourceUrl             String?
  sourceTitle           String?
  sourceRevision        String? // manufacturer doc version/date, e.g. "Rev 3, Jan 2025" — free text since manufacturers don't use one consistent format

  verifiedById String?
  verifiedBy   User?     @relation("MaterialKnowledgeVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  reviewNotes  String?   @db.Text // internal only — never returned to a customer-facing request

  relatedMaterials MaterialRelatedProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
}

enum RelatedMaterialRole {
  PRIMER
  SEALANT
  ADHESIVE
  GROUT
  CLEANER
  MESH
  PUTTY
  WATERPROOFING_LAYER
  APPLICATION_TOOL
  PROTECTIVE_EQUIPMENT
  SUPPORTING_MATERIAL
  OTHER
}

// Explicit, admin-curated links only — never inferred from name/category
// similarity. "reason" is required so every recommendation on the storefront
// can say *why* it's relevant, not just that it is.
model MaterialRelatedProduct {
  id                  String            @id @default(cuid())
  materialKnowledgeId String
  materialKnowledge   MaterialKnowledge @relation(fields: [materialKnowledgeId], references: [id], onDelete: Cascade)
  relatedProductId    String
  relatedProduct      Product           @relation("RelatedProductLink", fields: [relatedProductId], references: [id], onDelete: Cascade)
  role                RelatedMaterialRole
  reason              String            @db.Text
  sequenceNote        String?           @db.Text // e.g. "Apply before this product", "Only if surface was previously painted"
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())

  @@unique([materialKnowledgeId, relatedProductId])
  @@index([relatedProductId])
}

model ProductImage {
  id        String  @id @default(cuid())
  src       String
  alt       String
  sortOrder Int     @default(0)
  primary   Boolean @default(false)

  // Mandatory: Every image belongs to a product
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Optional: For variant-specific looks (tiles, paint, etc.)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, primary, sortOrder])
}

model Review {
  id      String   @id @default(cuid())
  rating  Int
  comment String   @db.Text
  date    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ==========================================
// 4. PRODUCT VARIANT & SUPPLIERS
// ==========================================

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  sku       String  @unique

  price                Decimal?      @db.Decimal(12, 2)
  attributes           Json // e.g. { "size": "600x600mm", "grade": "M25" }
  unit                 String        @default("unit")
  minimumOrderQuantity Int           @default(1)
  stockQuantity        Int           @default(0)
  reservedQuantity     Int           @default(0)
  lowStockThreshold    Int           @default(5)
  stockTracked         Boolean       @default(false)
  status               VariantStatus @default(ACTIVE)

  purchaseMode                 PurchaseMode @default(QUOTE_ONLY)
  maxDirectQuantity             Int?
  bulkQuoteThreshold             Int?
  quantityIncrement              Int          @default(1)
  directCheckoutEnabled          Boolean      @default(false)
  manualDeliveryPricingEnabled   Boolean      @default(false)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  images                   ProductImage[]
  stockTransactions        StockTransaction[]
  inventoryBalances        InventoryBalance[]
  inventoryReservations    InventoryReservation[]
  stockTransferItems       StockTransferItem[]
  stockCountItems          StockCountItem[]
  supplierProducts         SupplierProduct[]
  dealerProducts           DealerProduct[]
  quotationItems           QuotationItem[]
  quotationRevisionItems   QuotationRevisionItem[]
  salesOrderItems          SalesOrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  supplierRfqItems         SupplierRFQItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceiptItems        GoodsReceiptItem[]
  supplierReturnItems      SupplierReturnItem[]
  returnItems              ReturnItem[]
  replacementItems         ReplacementItem[]
  calculatorMappings       CalculatorProductMapping[]
  estimateItems            MaterialEstimateItem[]
  cartItems                 CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([productId, status])
  @@index([stockQuantity, lowStockThreshold])
}

model StockTransaction {
  id               String               @id @default(cuid())
  variantId        String
  variant          ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stockDelta       Int                  @default(0)
  reservedDelta    Int                  @default(0)
  previousStock    Int
  updatedStock     Int
  previousReserved Int
  updatedReserved  Int
  type             StockTransactionType
  reason           String
  reference        String?
  actorId          String?
  actor            User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([variantId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model Supplier {
  id          String  @id @default(cuid())
  name        String
  contactInfo String?
  email       String? @unique
  address     String?

  variants            ProductVariant[]
  fulfilmentLocations FulfilmentLocation[]
  supplierProducts    SupplierProduct[]
  supplierResponses   SupplierRFQResponse[]
  purchaseOrders      PurchaseOrder[]
  supplierReturns     SupplierReturn[]

  createdAt DateTime @default(now())
}

// ==========================================
// 5. LOCATION-AWARE INVENTORY & FULFILMENT
// ==========================================

model Unit {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  symbol          String
  dimension       String?
  active          Boolean          @default(true)
  conversionsFrom UnitConversion[] @relation("UnitConversionFrom")
  conversionsTo   UnitConversion[] @relation("UnitConversionTo")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([active, name])
}

model UnitConversion {
  id         String   @id @default(cuid())
  fromUnitId String
  fromUnit   Unit     @relation("UnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnitId   String
  toUnit     Unit     @relation("UnitConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)
  multiplier Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUnitId, toUnitId])
}

model Warehouse {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  address            String?
  city               String
  state              String
  pincode            String
  active             Boolean             @default(true)
  locations          WarehouseLocation[]
  fulfilmentLocation FulfilmentLocation?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, city])
}

model WarehouseLocation {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String
  zone        String?
  active      Boolean            @default(true)
  balances    InventoryBalance[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([warehouseId, code])
  @@index([warehouseId, active])
}

model Dealer {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  email              String?
  phone              String?
  address            String?
  city               String
  state              String
  pincode            String
  active             Boolean             @default(true)
  fulfilmentLocation FulfilmentLocation?
  products           DealerProduct[]
  serviceAreas       DealerServiceArea[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([active, city])
}

model Carrier {
  id                String               @id @default(cuid())
  code              String               @unique
  name              String
  email             String?
  phone             String?
  active            Boolean              @default(true)
  serviceAreas      CarrierServiceArea[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deliverySchedules DeliverySchedule[]
  dispatches        Dispatch[]

  @@index([active, name])
}

model ServiceArea {
  id                  String                  @id @default(cuid())
  code                String                  @unique
  name                String
  city                String
  state               String
  active              Boolean                 @default(true)
  pincodes            PincodeCoverage[]
  fulfilmentLocations FulfilmentServiceArea[]
  dealerAreas         DealerServiceArea[]
  carrierAreas        CarrierServiceArea[]
  supplierLeadTimes   SupplierLeadTime[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([active, city])
}

model PincodeCoverage {
  id            String      @id @default(cuid())
  serviceAreaId String
  serviceArea   ServiceArea @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  pincode       String
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([serviceAreaId, pincode])
  @@index([pincode, active])
}

model FulfilmentLocation {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  type                     FulfilmentLocationType
  mode                     FulfilmentMode
  active                   Boolean                   @default(true)
  warehouseId              String?                   @unique
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  dealerId                 String?                   @unique
  dealer                   Dealer?                   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  supplierId               String?
  supplier                 Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  serviceAreas             FulfilmentServiceArea[]
  balances                 InventoryBalance[]
  reservations             InventoryReservation[]
  transfersOut             StockTransfer[]           @relation("TransferOrigin")
  transfersIn              StockTransfer[]           @relation("TransferDestination")
  stockCounts              StockCount[]
  quotationRevisionItems   QuotationRevisionItem[]
  salesOrderItems          SalesOrderItem[]
  purchaseRequisitionItems PurchaseRequisitionItem[]
  supplierRfqItems         SupplierRFQItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceipts            GoodsReceipt[]
  supplierReturns          SupplierReturn[]
